go_test: opt into turnkey's test result caching.

Routes go_test's ExternalRunnerTestInfo arguments through test_caching_kwargs
(nix/buck2/prelude-extensions/test_caching). When the repo enables test
result caching, that also forces run_from_project_root and
use_project_relative_paths on (the upstream FIXME), so a go_test's command
no longer embeds the checkout's absolute path and other checkouts of the
same revision share results. When caching is off the arguments are
unchanged. See docs/specs/test-result-caching.md.

--- a/go/go_test.bzl
+++ b/go/go_test.bzl
@@ -12,6 +12,7 @@
     "LinkStyle",
 )
 load("@prelude//test:inject_test_run_info.bzl", "inject_test_run_info")
+load("@prelude//test_caching:test_caching.bzl", "test_caching_kwargs")
 load(
     "@prelude//tests:re_utils.bzl",
     "get_re_executors_from_props",
@@ -152,18 +153,18 @@
 
     return inject_test_run_info(
         ctx,
-        ExternalRunnerTestInfo(
-            type = "go",
-            command = [run_cmd],
-            env = ctx.attrs.env,
-            labels = ctx.attrs.labels,
-            contacts = ctx.attrs.contacts,
-            default_executor = re_executor,
-            executor_overrides = executor_overrides,
+        ExternalRunnerTestInfo(**test_caching_kwargs({
+            "type": "go",
+            "command": [run_cmd],
+            "env": ctx.attrs.env,
+            "labels": ctx.attrs.labels,
+            "contacts": ctx.attrs.contacts,
+            "default_executor": re_executor,
+            "executor_overrides": executor_overrides,
             # FIXME: Consider setting to true
-            run_from_project_root = re_executor != None,
-            use_project_relative_paths = re_executor != None,
-        ),
+            "run_from_project_root": re_executor != None,
+            "use_project_relative_paths": re_executor != None,
+        })),
     ) + [
         DefaultInfo(
             default_output = bin,
