rust_test: opt into turnkey's test result caching.

Routes rust_test's ExternalRunnerTestInfo arguments through
test_caching_kwargs (nix/buck2/prelude-extensions/test_caching), which, when
the repo enables test result caching, declares the test cacheable, gives it
the cache-reading executor and pins PATH and HOME. When caching is off the
arguments are unchanged. See docs/specs/test-result-caching.md.

From this prelude version on, upstream gives a test without a
remote_execution profile an explicit local executor with
remote_cache_enabled = False. The rule passes that executor on only for
targets with a remote_execution profile; for the others the caching helper
installs its cache-reading executor. That executor doesn't carry a target's
network_access policy: a test that needs the network shouldn't be cached
(label it no-test-cache).

--- a/rust/rust_binary.bzl
+++ b/rust/rust_binary.bzl
@@ -68,6 +68,7 @@
 load("@prelude//os_lookup:defs.bzl", "OsLookup")
 load("@prelude//rust/rust-analyzer:provider.bzl", "rust_analyzer_provider")
 load("@prelude//test:inject_test_run_info.bzl", "inject_test_run_info")
+load("@prelude//test_caching:test_caching.bzl", "test_caching_kwargs")
 load(
     "@prelude//tests:re_utils.bzl",
     "get_re_executors_from_props",
@@ -842,17 +843,20 @@
     return (
         inject_test_run_info(
             ctx,
-            ExternalRunnerTestInfo(
-                type = "rust",
-                command = [args],
-                env = ctx.attrs.env | ctx.attrs.run_env,
-                labels = ctx.attrs.labels,
-                contacts = ctx.attrs.contacts,
-                default_executor = re_executors.default_executor,
-                executor_overrides = re_executors.executor_overrides,
-                run_from_project_root = True,
-                use_project_relative_paths = True,
-            ),
+            ExternalRunnerTestInfo(**test_caching_kwargs({
+                "type": "rust",
+                "command": [args],
+                "env": ctx.attrs.env | ctx.attrs.run_env,
+                "labels": ctx.attrs.labels,
+                "contacts": ctx.attrs.contacts,
+                # Upstream gives a test without an RE profile an explicit
+                # local executor that never reads a cache; let the
+                # caching helper choose one for such tests instead.
+                "default_executor": re_executors.default_executor if getattr(ctx.attrs, "remote_execution", None) != None else None,
+                "executor_overrides": re_executors.executor_overrides,
+                "run_from_project_root": True,
+                "use_project_relative_paths": True,
+            })),
         )
         + providers
     )
