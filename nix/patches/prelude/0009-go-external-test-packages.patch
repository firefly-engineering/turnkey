+def _imports_any(build: GoPkgBuild, pkgs: dict[str, GoPkg]) -> bool:
+    for dep in build.deps:
+        if dep in pkgs:
+            return True
+    return False
+
+def _recompile_for_test(
+    ctx: AnalysisContext,
+    pkg_import_path: str,
+    tests: GoPkg,
+    deps: list[Dependency],
+) -> dict[str, GoPkg]:
+    """
+    Build again, for this test binary only, every package of the deps that
+    imports the package under test, directly or not, against the package as
+    built with its internal tests (tests), as go test does
+    (cmd/go/internal/load/test.go, recompileForTest). Only the external tests
+    can import such a package: the internal ones would be an import cycle.
+
+    Returns the packages the test binary has instead of its deps' ones, by
+    import path: the package under test, and the packages built again.
+    """
+    replaced_pkgs = {pkg_import_path: tests}
+    deps_pkgs = get_inherited_link_pkgs(deps)
+
+    # Postorder: a package comes after the packages it imports, which are
+    # then built again first
+    for build in go_pkg_builds(ctx.actions, deps).traverse(ordering = "postorder"):
+        if build.pkg_import_path in replaced_pkgs or not _imports_any(build, replaced_pkgs):
+            continue
+        pkg, _, _ = declare_package_build(
+            ctx = ctx,
+            pkg_import_path = build.pkg_import_path,
+            main = False,
+            sources = build.sources,
+            cgo_build_context = build.cgo_build_context,
+            config = build.config,
+            pkgs = {d: replaced_pkgs.get(d, deps_pkgs[d]) for d in build.deps},
+            go_list_out = build.go_list_out,
+            output_prefix = "recompiled_for_test/" + build.pkg_import_path,
+        )
+        replaced_pkgs[build.pkg_import_path] = pkg
+
+    return replaced_pkgs
+
