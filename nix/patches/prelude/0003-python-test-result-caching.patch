python_test: opt into turnkey's test result caching.

Passes python_test's ExternalRunnerTestInfo arguments, exactly as upstream builds
them, and its re_executors through test_caching_kwargs
(nix/buck2/prelude-extensions/test_caching/test_caching.bzl). That helper
decides what changes when the repo enables test result caching, and leaves
the arguments unchanged when it is off. It relies on re_executors.remote
(0005-re-utils-report-remote-executor.patch).

python_test adds PYTHONDONTWRITEBYTECODE, applied only when caching is on,
so a cached test doesn't write .pyc files into its own inputs.

--- a/python/compute_providers.bzl
+++ b/python/compute_providers.bzl
@@ -7,6 +7,7 @@
 # above-listed licenses.
 
 load("@prelude//test:inject_test_run_info.bzl", "inject_test_run_info")
+load("@prelude//test_caching:test_caching.bzl", "test_caching_kwargs")
 load(
     "@prelude//tests:re_utils.bzl",
     "get_re_executors_from_props",
@@ -43,19 +44,24 @@
 
     return inject_test_run_info(
         ctx,
-        ExternalRunnerTestInfo(
-            type = "pyunit",
-            command = [test_cmd],
-            env = test_env,
-            labels = ctx.attrs.labels,
-            contacts = ctx.attrs.contacts,
-            default_executor = re_executors.default_executor,
-            executor_overrides = re_executors.executor_overrides,
-            # We implicitly make this test via the project root, instead of
-            # the cell root (e.g. fbcode root). `network_access` is carried on
-            # the executor config (see `get_re_executors_from_props`).
-            run_from_project_root = re_executors.run_from_project_root,
-            use_project_relative_paths = re_executors.use_project_relative_paths,
-            supports_test_execution_caching = ctx.attrs.supports_test_execution_caching,
-        ),
+        ExternalRunnerTestInfo(**test_caching_kwargs(
+            {
+                "type": "pyunit",
+                "command": [test_cmd],
+                "env": test_env,
+                "labels": ctx.attrs.labels,
+                "contacts": ctx.attrs.contacts,
+                "default_executor": re_executors.default_executor,
+                "executor_overrides": re_executors.executor_overrides,
+                # We implicitly make this test via the project root, instead of
+                # the cell root (e.g. fbcode root). `network_access` is carried on
+                # the executor config (see `get_re_executors_from_props`).
+                "run_from_project_root": re_executors.run_from_project_root,
+                "use_project_relative_paths": re_executors.use_project_relative_paths,
+                "supports_test_execution_caching": ctx.attrs.supports_test_execution_caching,
+            },
+            re_executors,
+            # A cached test must not write bytecode into its own inputs.
+            extra_env = {"PYTHONDONTWRITEBYTECODE": "1"},
+        )),
     ) + [make_default_info(exe)]
