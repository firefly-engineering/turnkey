# Go Language Adapter for Dependency Cells
#
# Provides:
#   - mkGoDepPackage: Build a single Go module package: its source with its
#     fixup and user patches applied, and, given buckgen, its own
#     rules.star files, one per Go package
#   - mkGoDepsCell: The Go dependency cell's cell index (ADR 0004, ADR 0008)
#
# Go dependencies are fetched from the Go module proxy. Each module's
# rules.star files are generated in its own package, from its own source
# and the cell-wide settings alone; tk materialize lays the modules out as
# the cell the index describes.

{
  pkgs,
  lib,
  genericBuilder,
}:

let
  fetchers = import ../fetchers.nix { inherit pkgs lib; };
  inherit (genericBuilder) mkCellIndex;

  # The root cell's name in turnkey's .buckconfig (nix/buck2/buckconfig.nix):
  # a forwarding alias package names a go.work member's package in it
  rootCell = "root";

  # Generate buckgen configuration (JSON) for the cell named cellName.
  # conditions are the platforms and combined settings
  # (nix/buck2/platforms.nix's conditions), allowedBuildTags the Go build
  # tags that may vary per configuration (buck2.go.allowedBuildTags).
  mkBuckgenConfig =
    {
      cellName,
      conditions,
      allowedBuildTags,
    }:
    builtins.toJSON {
      buck = {
        # Note: preambule (sic) must end with newline for valid BUCK syntax
        preambule = "# Auto-generated by turnkey buckgen\n";
        go_library_rule = "go_library";
        deps_target_label_prefix = "${cellName}//vendor/";
        deps_attr = "deps";
        # Output filename for build files
        buildfile_name = "rules.star";
      };
      conditions = conditions // {
        go_tags = allowedBuildTags;
      };
      # The toolchain's release tags (go1.N) are set up to this version
      go_version = lib.versions.majorMinor pkgs.go.version;
    };

  # Go standard assembly headers content
  # These headers are normally at $GOROOT/pkg/include but Buck2's system_go_toolchain
  # doesn't include them in the assembly include path. We generate them in packages
  # that have assembly files so they can be found locally.
  textflagH = ''
    // textflag.h - Go assembly flags
    // Generated by turnkey for Buck2 compatibility
    #define NOPROF      1
    #define DUPOK       2
    #define NOSPLIT     4
    #define RODATA      8
    #define NOPTR       16
    #define WRAPPER     32
    #define NEEDCTXT    64
    #define TLSBSS      256
    #define NOFRAME     512
    #define REFLECTMETHOD 1024
    #define TOPFRAME    2048
    #define ABIWRAPPER  4096
  '';

  funcdataH = ''
    // funcdata.h - Go funcdata constants
    // Generated by turnkey for Buck2 compatibility
    #define PCDATA_UnsafePoint      0
    #define PCDATA_StackMapIndex    1
    #define PCDATA_InlTreeIndex     2
    #define PCDATA_ArgLiveIndex     3

    #define FUNCDATA_ArgsPointerMaps    0
    #define FUNCDATA_LocalsPointerMaps  1
    #define FUNCDATA_StackObjects       2
    #define FUNCDATA_InlTree            3
    #define FUNCDATA_OpenCodedDeferInfo 4
    #define FUNCDATA_ArgInfo            5
    #define FUNCDATA_ArgLiveInfo        6
    #define FUNCDATA_WrapInfo           7
  '';
in
rec {
  # Build inputs for per-dependency builds
  buildInputs = [ pkgs.go ];

  # ==========================================================================
  # Public API
  # ==========================================================================

  # Build a single Go module package
  mkGoDepPackage =
    {
      importPath, # Go import path (e.g., "github.com/spf13/cobra")
      version, # Version string (e.g., "v1.8.0")
      sha256, # SRI hash of the source

      # Optional
      fetchPath ? null, # Path to fetch from (if different from importPath, e.g., for forks)
      fixup ? null, # Custom fixup commands

      # The user's patches of this module (tk compose patch), in order. They
      # name files as a/vendor/<module path>/..., and apply after the fixup;
      # one that doesn't apply fails the module.
      userPatches ? [ ],

      # Optional, together: generate the module's rules.star files with
      # buckgen, from buckgenConfig (mkBuckgenConfig's) and the module's own
      # source. The `targets` output lists each Go package rendered as
      # "<subdir> <target>" ("." for the module's root), the `imports` output
      # the non-stdlib import paths their deps reference, one per line.
      buckgen ? null,
      buckgenConfig ? null,
    }:
    let
      # Use fetchPath if provided, otherwise importPath
      effectiveFetchPath = if fetchPath != null then fetchPath else importPath;
      fetchSpec = mkFetchSpec effectiveFetchPath version sha256;
      patchCommands = if fixup != null then fixup else "";
      generates = buckgen != null;
      # a/vendor/<module path>/...: a/, vendor/ and the module path's segments
      strip = 2 + lib.length (lib.splitString "/" importPath);
    in
    assert lib.assertMsg (
      generates == (buckgenConfig != null)
    ) "mkGoDepPackage: buckgen and buckgenConfig go together";
    pkgs.runCommand "dep-go-${lib.replaceStrings [ "/" "." ] [ "-" "-" ] importPath}"
      (
        {
          nativeBuildInputs =
            buildInputs
            ++ [ pkgs.findutils ]
            ++ lib.optional generates buckgen
            ++ lib.optional (userPatches != [ ]) pkgs.patch;
          src = fetchers.fetch fetchSpec;
          passthru = {
            inherit importPath version;
          };
        }
        // lib.optionalAttrs generates {
          outputs = [
            "out"
            "targets"
            "imports"
          ];
          inherit buckgenConfig;
          passAsFile = [ "buckgenConfig" ];
        }
      )
      (
        ''
          mkdir -p $out

          # Go proxy zips have the full module path as nested dirs
          # (e.g., golang.org/x/example/hello@v.../reverse/reverse.go)
          # fetchzip strips only the first level, so we need to find
          # the actual content root (directory containing go.mod).
          CONTENT_ROOT=$(find $src -name 'go.mod' -type f -printf '%h\n' | head -1)
          if [ -n "$CONTENT_ROOT" ]; then
            cp -r "$CONTENT_ROOT"/* $out/
          else
            cp -r $src/* $out/
          fi
          chmod -R u+w $out

          # Apply fixup if provided
          cd $out
          ${patchCommands}
        ''
        + lib.concatMapStrings (patchFile: ''

          # The user's patch ${baseNameOf patchFile}
          patch -d $out -p${toString strip} --forward --fuzz=0 < ${patchFile} || {
            echo "error: user patch ${baseNameOf patchFile} does not apply to ${importPath}@${version}"
            echo "  (regenerate it with 'tk compose patch', or remove it)"
            exit 1
          }
        '') userPatches
        + lib.optionalString generates ''

          # Buck2's system_go_toolchain doesn't provide -I $GOROOT/pkg/include,
          # so textflag.h and funcdata.h go next to the .s files including them
          find $out -name '*.s' -type f -printf '%h\n' | sort -u | while read dir; do
            if grep -q '#include "textflag.h"' "$dir"/*.s 2>/dev/null; then
              cat > "$dir/textflag.h" << 'TEXTFLAG_H'
          ${textflagH}
          TEXTFLAG_H
            fi
            if grep -q '#include "funcdata.h"' "$dir"/*.s 2>/dev/null; then
              cat > "$dir/funcdata.h" << 'FUNCDATA_H'
          ${funcdataH}
          FUNCDATA_H
            fi
          done

          # The module's rules.star files, from its own source alone
          buckgen \
            --config "$buckgenConfigPath" \
            --module-path ${lib.escapeShellArg importPath} \
            --targets-out $targets \
            --imports-out $imports \
            $out
        ''
      );

  # The user's patches of each locked module, keyed by module path, from
  # <dir>/<cellName>/vendor/<module path>/*.patch as tk compose patch writes
  # them (in name order). A directory holding patches must be a locked
  # module's: a Go package's directory inside a module is not.
  userPatchesOf =
    {
      dir,
      cellName,
      modulePaths,
    }:
    let
      cellDir = dir + "/${cellName}";
      entries = if dir != null && builtins.pathExists cellDir then builtins.readDir cellDir else { };
      flat = lib.filter (name: entries.${name} != "directory") (lib.attrNames entries);
      # Each directory under vendor/ holding patches, by its path there
      patchDirs =
        rel: path:
        let
          dirEntries = builtins.readDir path;
          patches = lib.sort (a: b: a < b) (
            lib.attrNames (
              lib.filterAttrs (name: type: type == "regular" && lib.hasSuffix ".patch" name) dirEntries
            )
          );
          subdirs = lib.attrNames (lib.filterAttrs (_: type: type == "directory") dirEntries);
        in
        lib.optionalAttrs (patches != [ ]) { ${rel} = map (name: path + "/${name}") patches; }
        // lib.foldl' (
          acc: sub: acc // patchDirs (if rel == "" then sub else "${rel}/${sub}") (path + "/${sub}")
        ) { } subdirs;
      found = if (entries.vendor or null) == "directory" then patchDirs "" (cellDir + "/vendor") else { };
      unknown = lib.filter (path: !builtins.elem path modulePaths) (lib.attrNames found);
    in
    if flat != [ ] then
      throw "turnkey: user patches for ${cellName} go under ${cellName}/vendor/<module path>/, one directory per module (tk compose patch writes them there); move or regenerate: ${lib.concatStringsSep ", " flat}"
    else if unknown != [ ] then
      throw "turnkey: user patches under ${cellName}/vendor/${lib.head unknown}/: ${cellName} locks no such module (patches go in their module's directory, not a package's inside it)"
    else
      found;

  # Build the Go dependency cell (ADR 0004, ADR 0008): each locked module's
  # own package (mkGoDepPackage, generating its rules.star files), and the
  # cell index that tk materialize keeps .turnkey/<cellName> in line with.
  # The result is the index, with depPackages (each module's package, keyed
  # as go-deps.toml keys it) and index (itself) alongside.
  mkGoDepsCell =
    {
      cellName, # The cell's name (nix/buck2/languages.nix)
      depsFile, # Path to go-deps.toml
      buckgen, # buckgen tool derivation

      # Optional
      # The locked dependencies' fixups: [ { key; name; version; } ] ->
      # { fixups = { <key> = { commands; }; }; } (nix/lib/fixups's resolve)
      resolveFixups ? (_: { fixups = { }; }),
      # The user's patches (tk compose patch): <dir>/<cellName>/vendor/<module path>/
      userPatchesDir ? null,

      # The platforms to build for and their combined settings
      # (nix/buck2/platforms.nix's conditions), and the allowed build tags
      conditions,
      allowedBuildTags ? [ ],
    }:
    let
      depsToml = builtins.fromTOML (builtins.readFile depsFile);
      deps = depsToml.deps or { };
      schemaVersion = depsToml.schema_version or 1;

      # The go.work members (godeps-gen's [members]): module path -> its
      # directory, relative to the project root
      members = lib.mapAttrs (_: member: member.dir) (depsToml.members or { });

      # Every module's rules.star files are generated with the same settings
      buckgenConfig = mkBuckgenConfig {
        inherit cellName conditions allowedBuildTags;
      };

      # Parse dependency info based on schema version
      # v1: key is import path, version in depSpec.version
      # v2: key is "import-path@version", import_path in depSpec.import_path
      #     optional fetch_path for external fork replaces
      parseDep =
        key: depSpec:
        if schemaVersion >= 2 then
          {
            importPath = depSpec.import_path;
            fetchPath = depSpec.fetch_path or null;
            version = depSpec.version;
          }
        else
          {
            importPath = key;
            fetchPath = null;
            version = depSpec.version;
          };
      parsedDeps = lib.mapAttrs parseDep deps;

      # A module path has one version (ADR 0007): the cell names no version
      modulePaths = lib.mapAttrsToList (_: parsed: parsed.importPath) parsedDeps;
      duplicates = lib.filter (path: lib.count (p: p == path) modulePaths > 1) (lib.unique modulePaths);

      # The locked modules' fixups, keyed as deps is
      resolvedFixups = resolveFixups (
        lib.mapAttrsToList (key: parsed: {
          inherit key;
          name = parsed.importPath;
          inherit (parsed) version;
        }) parsedDeps
      );

      userPatches = userPatchesOf {
        dir = userPatchesDir;
        inherit cellName modulePaths;
      };

      depPackages = lib.mapAttrs (
        key: parsed:
        mkGoDepPackage {
          inherit (parsed) importPath fetchPath version;
          sha256 = deps.${key}.hash;
          fixup = resolvedFixups.fixups.${key}.commands or "";
          userPatches = userPatches.${parsed.importPath} or [ ];
          inherit buckgen buckgenConfig;
        }
      ) parsedDeps;

      # Each module's Go packages, at vendor/<import path>, and a forwarding
      # alias package for each import path they reference that a member owns
      index = mkCellIndex {
        inherit
          cellName
          depsFile
          rootCell
          members
          ;
        packages = { };
        aliases = { };
        modules = lib.mapAttrs' (
          key: package: lib.nameValuePair parsedDeps.${key}.importPath package
        ) depPackages;
      };
    in
    assert lib.assertMsg (duplicates == [ ])
      "turnkey: ${toString depsFile} locks more than one version of ${lib.concatStringsSep ", " duplicates}; regenerate it with tk sync";
    index // { inherit depPackages index; };

  # ==========================================================================
  # Internal Helpers
  # ==========================================================================

  # Create fetch spec from Go import path. Every module comes from the Go
  # module proxy: the prefetcher hashes the proxy's zip, and the proxy
  # serves every public module, whatever its host.
  mkFetchSpec =
    importPath: version: sha256:
    fetchers.mkGoProxySpec {
      modulePath = importPath;
      inherit version sha256;
    };
}
