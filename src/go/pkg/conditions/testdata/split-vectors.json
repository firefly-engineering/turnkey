    {
      "name": "the same labels everywhere are common",
      "platforms": [
        {
          "os": "linux",
          "cpu": "x86_64"
        },
        {
          "os": "linux",
          "cpu": "arm64"
        },
        {
          "os": "macos",
          "cpu": "x86_64"
        },
        {
          "os": "macos",
          "cpu": "arm64"
        }
      ],
      "settings": "toolchains//conditions",
      "dimensions": [],
      "labels": [
        {
          "when": {},
          "labels": [
            "//a:a",
            "//b:b"
          ]
        }
      ],
      "common": [
        "//a:a",
        "//b:b"
      ],
      "branches": []
    },
