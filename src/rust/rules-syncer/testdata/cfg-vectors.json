{
  "description": "Cargo platform specs ([target.'<spec>'.dependencies]) and the platforms (<os>-<cpu>, in Buck2's names) each one matches. Checked against rustc 1.94's --print cfg; read by src/rust/rules-syncer's tests.",
  "platforms": [
    {
      "os": "linux",
      "cpu": "x86_64"
    },
    {
      "os": "linux",
      "cpu": "arm64"
    },
    {
      "os": "macos",
      "cpu": "x86_64"
    },
    {
      "os": "macos",
      "cpu": "arm64"
    }
  ],
  "cfg": [
    {
      "spec": "cfg(unix)",
      "matches": [
        "linux-arm64",
        "linux-x86_64",
        "macos-arm64",
        "macos-x86_64"
      ]
    },
    {
      "spec": "cfg(windows)",
      "matches": []
    },
    {
      "spec": "cfg(target_os = \"linux\")",
      "matches": [
        "linux-arm64",
        "linux-x86_64"
      ]
    },
    {
      "spec": "cfg(target_os = \"macos\")",
      "matches": [
        "macos-arm64",
        "macos-x86_64"
      ]
    },
    {
      "spec": "cfg(not(target_os = \"linux\"))",
      "matches": [
        "macos-arm64",
        "macos-x86_64"
      ]
    },
    {
      "spec": "cfg(any(target_os = \"linux\", target_os = \"android\"))",
      "matches": [
        "linux-arm64",
        "linux-x86_64"
      ]
    },
    {
      "spec": "cfg(all(target_os = \"linux\", target_arch = \"aarch64\"))",
      "matches": [
        "linux-arm64"
      ]
    },
    {
      "spec": "cfg(target_arch = \"x86_64\")",
      "matches": [
        "linux-x86_64",
        "macos-x86_64"
      ]
    },
    {
      "spec": "cfg(any(target_arch = \"x86\", target_arch = \"x86_64\"))",
      "matches": [
        "linux-x86_64",
        "macos-x86_64"
      ]
    },
    {
      "spec": "cfg(target_family = \"unix\")",
      "matches": [
        "linux-arm64",
        "linux-x86_64",
        "macos-arm64",
        "macos-x86_64"
      ]
    },
    {
      "spec": "cfg(target_family = \"windows\")",
      "matches": []
    },
    {
      "spec": "cfg(target_pointer_width = \"64\")",
      "matches": [
        "linux-arm64",
        "linux-x86_64",
        "macos-arm64",
        "macos-x86_64"
      ]
    },
    {
      "spec": "cfg(target_pointer_width = \"32\")",
      "matches": []
